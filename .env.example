# https://secure.proposales.com/settings/profile
PROPOSALES_API_KEY=

# true = serve fixtures from app/_clients/proposales/mocks instead of calling Proposales (no key needed)
# error = simulate Proposales being down, to check error states
PROPOSALES_MOCK=

# No real golf booking system is connected. Set to true to serve the fixtures in
# app/_clients/golf-booking/mocks - needed for the group-days form to have prices. Empty = fails as
# not configured; error = simulate it being down.
GOLF_BOOKING_MOCK=

# Where drafts from the group-days form go - the club's company id (GET /v3/companies) and, once
# the club has one, its template's uuid (GET /v3/companies/{id}/templates).
PROPOSALES_COMPANY_ID=
PROPOSALES_TEMPLATE_UUID=

# The model behind "describe your day", through the Vercel AI Gateway. Locally: a key from
# https://vercel.com/dashboard -> AI Gateway -> API keys. On Vercel, leave it unset - the
# deployment's OIDC token is used.
AI_GATEWAY_API_KEY=

# true = fixed picks from app/_clients/ai/mocks instead of calling the model (no key, no cost)
# error = simulate the model being down
AI_MOCK=
