# https://secure.proposales.com/settings/profile
PROPOSALES_API_KEY=

# true = serve fixtures from app/_lib/proposales/mocks instead of calling Proposales (no key needed)
# error = simulate Proposales being down, to check error states
PROPOSALES_MOCK=

# The club's golf booking system is mocked - its fixtures in app/_lib/golf-booking/mocks are the data.
# error = simulate it being down, to check the "prices aren't available" state
GOLF_BOOKING_MOCK=
